[Unit]
Description=Independent SO101 AI Learning UI (no hardware on startup)
After=network.target
[Service]
WorkingDirectory=/home/jetsonnx/Projects/so101_ai_learning
ExecStart=/home/jetsonnx/Projects/so101_ai_learning/.venv/bin/python -m uvicorn so101_lab.app:app --host 0.0.0.0 --port 8020
Environment=HF_HUB_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Restart=on-failure
RestartSec=5
[Install]
WantedBy=default.target
